# Server-only configuration. Both flags remain OFF until AWS and MongoDB setup.
S3_UPLOAD_ENABLED=false
S3_PLAYBACK_ENABLED=false
AWS_REGION=ap-south-1
S3_MEDIA_BUCKET=
S3_UPLOAD_URL_TTL_SECONDS=600
S3_ACCESS_URL_TTL_SECONDS=600

# Video-only HLS processing. Keep disabled until the separate worker is ready.
S3_VIDEO_SEGMENTATION_ENABLED=false
VIDEO_WORKER_ENABLED=false
# Exact existing tenant ObjectId; worker never scans other tenants.
VIDEO_WORKER_TENANT_ID=
# Optional: isolated scratch location; allow source size + 22 GiB free per job.
# VIDEO_TEMP_ROOT=C:/finops-video-temp
# Optional executable overrides; installed static binaries are used otherwise.
# FFMPEG_PATH=
# FFPROBE_PATH=
# Use an IAM role/provider chain where available. Do not add NEXT_PUBLIC keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
